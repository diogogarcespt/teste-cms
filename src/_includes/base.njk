<!doctype html>
<html lang="pt">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.nome }}</title>
  <meta name="description" content="{{ descricao or inicio.subtitulo }}">
  <link rel="stylesheet" href="/assets/estilo.css">
</head>
<body>
  <header class="topo">
    <div class="wrap topo-in">
      <a class="logo" href="/">{{ site.nome }}</a>
      <nav><a href="/">Início</a><a href="/produtos/">Produtos</a><a href="/#contactos">Contactos</a></nav>
    </div>
  </header>
  <main>{{ content | safe }}</main>
  <footer class="rodape" id="contactos">
    <div class="wrap">
      <strong>{{ site.nome }}</strong>
      <p>{{ site.morada }}<br>{{ site.telefone }} · <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <small>Protótipo de teste — conteúdo editável em /admin</small>
    </div>
  </footer>
</body>
</html>
