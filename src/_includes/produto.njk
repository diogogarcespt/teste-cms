---
layout: base.njk
---
<section class="wrap ficha">
  <a class="voltar" href="/produtos/">← Todos os produtos</a>
  <div class="ficha-grid">
    <div class="foto grande">{% if imagem %}<img src="{{ imagem }}" alt="{{ title }}">{% else %}<span>Sem foto</span>{% endif %}</div>
    <div>
      <small class="etiqueta">{{ gama }} · Ref. {{ ref }}</small>
      <h1>{{ title }}</h1>
      <p class="lead">{{ descricao }}</p>
      {{ content | safe }}
      {% set linhas = [["Dimensões do tampo", dimensoes], ["Peso", peso], ["Tubo", tubo], ["Alturas", alturas], ["Capa", capa], ["Código EAN", ean]] %}
      <h2>Dados técnicos</h2>
      <table class="tecnica">
        {% for l in linhas %}{% if l[1] %}<tr><th>{{ l[0] }}</th><td>{{ l[1] }}</td></tr>{% endif %}{% endfor %}
      </table>
      {% if not (dimensoes or peso or tubo or alturas or capa or ean) %}<p class="nota">Dados técnicos por preencher.</p>{% endif %}
      <a class="botao" href="mailto:{{ site.email }}?subject=Pedido de orçamento: {{ title }} (Ref. {{ ref }})">Pedir orçamento</a>
    </div>
  </div>
</section>
