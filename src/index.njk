---
layout: base.njk
---
<section class="hero">
  <div class="wrap">
    <h1>{{ inicio.titulo }}</h1>
    <p>{{ inicio.subtitulo }}</p>
    <a class="botao claro" href="/produtos/">Ver produtos</a>
  </div>
</section>
<section class="wrap bloco">
  <h2>Produtos em destaque</h2>
  <div class="grelha">
    {% for p in collections.produtos %}{% if p.data.destaque %}{% include "cartao.njk" %}{% endif %}{% endfor %}
  </div>
</section>
<section class="wrap bloco sobre">
  <h2>Fabrico próprio</h2>
  <p>{{ inicio.sobre }}</p>
</section>
