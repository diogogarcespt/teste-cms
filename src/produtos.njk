---
layout: base.njk
title: Produtos
permalink: /produtos/
---
<section class="wrap bloco">
  <h1>Produtos</h1>
  <div class="filtros">
    <button class="ativo" data-f="todos">Todos</button>
    {% for g in gamas %}<button data-f="{{ g | slugify }}">{{ g }}</button>{% endfor %}
  </div>
  <div class="grelha" id="grelha">
    {% for p in collections.produtos %}{% include "cartao.njk" %}{% endfor %}
  </div>
  <p class="nota" id="vazio" hidden>Ainda não há produtos nesta gama.</p>
</section>
<script>
  const bts = document.querySelectorAll('.filtros button');
  bts.forEach(b => b.addEventListener('click', () => {
    bts.forEach(x => x.classList.toggle('ativo', x === b));
    let n = 0;
    document.querySelectorAll('#grelha .cartao').forEach(c => {
      const ver = b.dataset.f === 'todos' || c.dataset.gama === b.dataset.f;
      c.hidden = !ver; if (ver) n++;
    });
    document.getElementById('vazio').hidden = n > 0;
  }));
</script>
